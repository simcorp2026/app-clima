<Window x:Class="TiempoApp.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TiempoApp.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="TiempoApp" Width="600" Height="720" MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource AppFont}" FontSize="14"
        Foreground="{StaticResource TextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=CityBox}"
        TextOptions.TextFormattingMode="Display">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="540" Margin="24,40,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⛅" FontFamily="Segoe UI Emoji" FontSize="34" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{StaticResource PrimaryBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TiempoApp" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="El clima actual de cualquier ciudad" Foreground="{StaticResource TextMutedBrush}" FontSize="15" />
                </StackPanel>
            </StackPanel>

            <!-- Search -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CityBox" Style="{StaticResource SearchBox}" Tag="Ciudad, p. ej. Quito" MaxLength="100"
                         AutomationProperties.Name="Ciudad"
                         Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Content="Buscar" Command="{Binding SearchCommand}" />
            </Grid>

            <!-- Example city chips -->
            <ItemsControl Grid.Row="2" Margin="0,12,0,0" ItemsSource="{Binding SampleCities}"
                          AutomationProperties.Name="Ciudades de ejemplo">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Chip}" Content="{Binding}"
                                Command="{Binding DataContext.SearchCityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Result area: one state visible at a time -->
            <Grid Grid.Row="3" Margin="0,16,0,0">

                <!-- Empty -->
                <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle RadiusX="16" RadiusY="16" Fill="{StaticResource SurfaceBrush}"
                               Stroke="{StaticResource BorderBrush}" StrokeDashArray="4 3" />
                    <StackPanel Margin="24,20">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="15"
                                   Text="Escribe el nombre de una ciudad para ver su temperatura, humedad y viento." />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0">
                            <Run Text="Si hay ciudades con el mismo nombre, añade el país:" />
                            <Run Text="Valencia,VE" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Loading -->
                <Border Style="{StaticResource Card}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Buscando el clima…" Foreground="{StaticResource TextMutedBrush}" FontSize="15" />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,14" BorderThickness="0"
                                     Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource SurfaceMutedBrush}" />
                        <Button Style="{StaticResource LinkButton}" Content="Cancelar" HorizontalAlignment="Left"
                                Command="{Binding SearchCancelCommand}" />
                    </StackPanel>
                </Border>

                <!-- Error -->
                <Border CornerRadius="16" Padding="24,20" Background="{StaticResource DangerBgBrush}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorTitle}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="15" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                </Border>

                <!-- Weather card -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasWeather, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding Weather}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding City}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Country}" Foreground="{StaticResource TextMutedBrush}" FontSize="15" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding LocalTime}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,24">
                            <Grid Width="100" Height="100">
                                <Ellipse Fill="{StaticResource IconBgBrush}" />
                                <Image Source="{Binding IconUrl}" Width="100" Height="100" RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.Name="{Binding Description}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Temperature}" FontSize="64" FontWeight="Light" />
                                    <TextBlock Text="{Binding Unit}" FontSize="28" Margin="4,10,0,0" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="17" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <UniformGrid Columns="3" Margin="-4,0">
                            <Border Style="{StaticResource Stat}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatLabel}" Text="🌡 Sensación" />
                                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding FeelsLike}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Stat}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatLabel}" Text="💧 Humedad" />
                                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding Humidity}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Stat}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatLabel}" Text="💨 Viento" />
                                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding Wind}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer -->
            <TextBlock Grid.Row="5" HorizontalAlignment="Center" Margin="0,24,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                <Run Text="{Binding SourceLabel, Mode=OneWay}" /><Run Text=" · Datos de " /><Hyperlink NavigateUri="https://openweathermap.org/" RequestNavigate="OnHyperlinkNavigate"
                           Foreground="{StaticResource TextMutedBrush}">OpenWeatherMap</Hyperlink>
            </TextBlock>
        </Grid>
    </ScrollViewer>
</Window>
