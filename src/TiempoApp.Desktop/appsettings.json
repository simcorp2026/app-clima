{
  "WeatherSource": {
    // "Direct": calls OpenWeatherMap with the key from User Secrets (local demo only).
    // "Api":    calls TiempoApp.Web (local or deployed); the key never reaches this app.
    "Mode": "Direct",
    "ApiBaseUrl": "https://localhost:7274/"
  },
  "OpenWeather": {
    "BaseUrl": "https://api.openweathermap.org/data/2.5/",
    "IconBaseUrl": "https://openweathermap.org/img/wn/",
    "Units": "metric",
    "Lang": "es",
    "CacheMinutes": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
